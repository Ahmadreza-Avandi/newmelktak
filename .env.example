# ==============================================================================
# MelkTek / Amlak OS - Complete Environment Template (.env.example)
# Copy to .env (`cp .env.example .env`) and replace secret/empty values.
# ==============================================================================

# --- Server & Runtime ---
# NODE_ENV=development
PORT=3000
DATA_DIR=./data
APP_URL=
ALLOWED_ORIGINS=
TRUST_PROXY=
SEED_DEMO_DATA=false

# --- PostgreSQL Database ---
# Leave DATABASE_URL empty in development to use embedded PGlite (./data/amlak_postgres).
# Required in production (e.g. postgresql://amlak_app:URL_ENCODED_PASSWORD@127.0.0.1:5432/amlak_os)
DATABASE_URL=
PGSSL=false
PG_POOL_MAX=10

# --- Platform Admin & Database Studio (/platform and /db-admin) ---
# Username: 3-80 chars [a-z0-9_.-]
# Password: minimum 16 chars, maximum 72 UTF-8 bytes (replace before running)
PLATFORM_ADMIN_USERNAME=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_NAME=
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PHONE=

# Optional in development (defaults to /platform).
# Required in production: single path segment starting with / + 16-80 chars (e.g. /office-xxxxxxxxxxxxxxxx)
PLATFORM_PATH=

# --- Structured Logging & Retention ---
LOG_LEVEL=INFO
LOG_DB_LEVEL=INFO
LOG_FILE_ENABLED=true
LOG_RETENTION_DAYS=30
LOG_MAX_DB_ROWS=50000
LOG_MAX_FILE_BYTES=5242880
LOG_MAX_FILES=5

# --- Optional Drizzle / External SQL Tooling ---
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=